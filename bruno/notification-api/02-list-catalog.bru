meta {
  name: List Notification Catalog
  type: http
  seq: 2
  tags: [
    smoke
    e2e
  ]
}

get {
  url: {{baseUrl}}/v1/catalog
  body: none
  auth: none
}

headers {
  content-type: application/json
}

tests {
  test("catalog returns supported categories and channels", function () {
    const payload = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(payload.categories).to.deep.equal([
      { code: "sports", label: "Sports" },
      { code: "finance", label: "Finance" },
      { code: "movies", label: "Movies" }
    ]);
    expect(payload.channels).to.deep.equal([
      { code: "sms", label: "SMS" },
      { code: "email", label: "E-Mail" },
      { code: "push", label: "Push Notification" }
    ]);
  });
}
