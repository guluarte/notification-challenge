meta {
  name: Create Message Idempotency Replay
  type: http
  seq: 4
  tags: [
    regression
    e2e
  ]
}

post {
  url: {{baseUrl}}/v1/messages
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{messageIdempotencyKey}}
}

body {
  {
    "category": "sports",
    "body": "{{messageBody}}"
  }
}

tests {
  test("duplicate idempotency key replays the original message", function () {
    const payload = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(payload.message_id).to.equal(bru.getVar("messageId"));
    expect(payload.category).to.equal("sports");
    expect(payload.body).to.equal(bru.getVar("messageBody"));
    expect(payload.total_users).to.equal(2);
    expect(payload.total_attempts).to.equal(5);
    expect(payload.sent).to.equal(5);
    expect(payload.failed).to.equal(0);
  });
}
