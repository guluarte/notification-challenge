meta {
  name: Health Check
  type: http
  seq: 1
  tags: [
    smoke
    e2e
  ]
}

get {
  url: {{baseUrl}}/v1/health
  body: none
  auth: none
}

headers {
  content-type: application/json
}

tests {
  test("health responds with success", function () {
    const payload = res.getBody();

    expect(res.getStatus()).to.equal(200);
    expect(payload.status).to.equal("ok");
    expect(payload.database).to.equal("ok");
  });
}
