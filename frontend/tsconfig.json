{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["vite/client"],
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.js"]
}
