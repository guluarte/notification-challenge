{
	"compilerOptions": {
		"baseUrl": ".",
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["vite/client"],
		"ignoreDeprecations": "6.0",
		"paths": {
			"@/*": ["./src/*"]
		},
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts"]
}
